# Copy to .env for local development. Never commit .env.
# All gateway settings use the DMD_GW_ prefix.

DMD_GW_ENVIRONMENT=development
DMD_GW_LOG_LEVEL=INFO

# Local development database (matches docker-compose.yml). Production must set its own.
DMD_GW_DATABASE_URL=postgresql+psycopg://gateway:gateway-dev-only@localhost:5432/agent_gateway

DMD_GW_PUBLIC_BASE_URL=http://localhost:8000
# The MCP endpoint is served at <public base URL>/mcp. Set this only when agents reach it at
# another public address (e.g. https://agents.debitmydata.io/mcp through a proxy).
DMD_GW_MCP_URL=

DMD_GW_ROUTE_REGISTRY_PATH=config/payment_routes.yaml

# How long a payment quote stays valid, in seconds (DEC-03: 15 minutes, as in the directive).
DMD_GW_QUOTE_TTL_SECONDS=900

# How often the payment worker (dmd-gateway-worker) checks open payments, in seconds.
DMD_GW_WORKER_INTERVAL_SECONDS=10

# Ed25519 key that signs registration credentials. Create it with:
#   dmd-gateway-issuer-key secrets/issuer-key.pem
# Leave empty to keep DID issuance off. Production refuses a key file (separate signer, ID-15).
DMD_GW_ISSUER_KEY_PATH=

# How long an agent has to sign a controller challenge, in seconds.
DMD_GW_CONTROLLER_CHALLENGE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Payment rails. Every rail is OFF unless its *_ENABLED flag is true AND the
# rail is complete in config/payment_routes.yaml AND its adapter exists.
# A *_KILL flag set to anything other than 0/false/no/off forces the rail off.
# ---------------------------------------------------------------------------
DMD_RAIL_DMD_POW_NATIVE_ENABLED=false
DMD_RAIL_DMD_POW_NATIVE_KILL=

# Private DMD node RPC used by the native DMD rail. Loopback or private IP only.
# The wallet must be a WATCH-ONLY descriptor wallet (the gateway refuses a wallet that can spend).
# Regtest RPC port is 58557; mainnet is 18557.
DMD_RPC_URL=http://127.0.0.1:58557
DMD_RPC_USER=gateway
DMD_RPC_PASSWORD=
DMD_RPC_WALLET=gateway-receive

# Fixed DMD/USD test price for regtest/testnet demos only (ignored in production).
DMD_STATIC_TEST_PRICE_USD=

DMD_RAIL_X402_USDC_BASE_ENABLED=false
DMD_RAIL_X402_USDC_BASE_KILL=
# Merchant receiving address for USDC on Base (required before that rail can be enabled).
DMD_USDC_BASE_MERCHANT_ADDRESS=
# Receiving address of agents' inference donations (USDC on Base, POST /v1/donations/inference).
# Production: the "AgenticInference Pay" wallet, 0x3BA9A001ec76Dc24384f8dEE8bE3479cE45bD42E.
# Unset: donations are not offered.
DMD_USDC_BASE_INFERENCE_ADDRESS=
# x402 facilitator (verifies and broadcasts payments). https://x402.org/facilitator serves
# test networks only. Base mainnet: Coinbase's CDP facilitator (DEC-08),
# https://api.cdp.coinbase.com/platform/v2/x402, the one that lists endpoints in the Bazaar.
DMD_X402_FACILITATOR_URL=
# CDP facilitator only: a CDP "Secret API key" (Ed25519 recommended). The secret is a
# secret: environment only, never in files under version control.
DMD_X402_CDP_API_KEY_ID=
DMD_X402_CDP_API_KEY_SECRET=
# Base JSON-RPC endpoint the gateway reads to check every settlement itself (read-only).
# Base Sepolia: https://sepolia.base.org. Provider URLs with an API key are secrets.
DMD_BASE_RPC_URL=
# How long a paid registration waits for confirmations before answering 202, in seconds.
DMD_GW_X402_SETTLEMENT_WAIT_SECONDS=30

# --- Monitoring and alerts (dmd-gateway-monitor; see docs/monitoring.md) ---
# Comma-separated email addresses: every alert / critical alerts only / the daily report.
DMD_GW_ALERT_EMAIL_TO=
DMD_GW_ALERT_EMAIL_CRITICAL_TO=
DMD_GW_REPORT_EMAIL_TO=
# The mailbox that sends them (SMTP with TLS: port 587 with starttls, or 465 with ssl).
DMD_GW_ALERT_SMTP_HOST=
DMD_GW_ALERT_SMTP_PORT=587
DMD_GW_ALERT_SMTP_SECURITY=starttls
DMD_GW_ALERT_SMTP_USERNAME=
DMD_GW_ALERT_SMTP_FROM=
# Secret: environment only, never in files under version control.
DMD_ALERT_SMTP_PASSWORD=
# Secret: the webhook URL of a private Discord channel.
DMD_ALERT_DISCORD_WEBHOOK_URL=
# Discord user ID mentioned in critical alerts.
DMD_GW_ALERT_DISCORD_MENTION_USER_ID=
