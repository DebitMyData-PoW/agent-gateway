# Copy to .env for local development. Never commit .env.
# All gateway settings use the DMD_GW_ prefix.

DMD_GW_ENVIRONMENT=development
DMD_GW_LOG_LEVEL=INFO

# Local development database (matches docker-compose.yml). Production must set its own.
DMD_GW_DATABASE_URL=postgresql+psycopg://gateway:gateway-dev-only@localhost:5432/agent_gateway

DMD_GW_PUBLIC_BASE_URL=http://localhost:8000
# Leave empty until the MCP endpoint is actually deployed; discovery only advertises it when set.
DMD_GW_MCP_URL=

DMD_GW_ROUTE_REGISTRY_PATH=config/payment_routes.yaml

# How long a payment quote stays valid, in seconds (DEC-03; the directive's example uses 15 min).
DMD_GW_QUOTE_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# Payment rails. Every rail is OFF unless its *_ENABLED flag is true AND the
# rail is complete in config/payment_routes.yaml AND its adapter exists.
# A *_KILL flag set to anything other than 0/false/no/off forces the rail off.
# ---------------------------------------------------------------------------
DMD_RAIL_DMD_POW_NATIVE_ENABLED=false
DMD_RAIL_DMD_POW_NATIVE_KILL=

DMD_RAIL_X402_USDC_BASE_ENABLED=false
DMD_RAIL_X402_USDC_BASE_KILL=
# Merchant receiving address for USDC on Base (required before that rail can be enabled).
DMD_USDC_BASE_MERCHANT_ADDRESS=
